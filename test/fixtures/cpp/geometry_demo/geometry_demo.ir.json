        "signature": "T clamp2(T v, T lo, T hi)",
        "docstring": null,
        "source": "T clamp2(T v, T lo, T hi) {\n  if (v < lo) {\n    return lo;\n  }\n  if (v > hi) {\n    return hi;\n  }\n  return v;\n}"
      },
