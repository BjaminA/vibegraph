        "signature": "prepare()",
        "docstring": "Clean the build dir and pack the release tarball.",
        "source": "prepare() {\n  rm -rf build/\n  mkdir -p build/\n  tar -czf \"build/app-$RELEASE.tgz\" src/\n}"
      },
      {
        "sym": "function:upload",
        "kind": "function",
        "name": "upload",
        "scope": "module",
        "loc": {
          "line": 23,
          "endLine": 31,
          "col": 0,
          "endCol": 1
        },
        "signature": "upload($1)",
        "docstring": "Upload the tarball to the target environment (staging|canary|prod).",
        "source": "upload() {\n  if [ \"$1\" = \"staging\" ]; then\n    curl -fsS -T \"build/app-$RELEASE.tgz\" \"https://staging.example.com/upload\"\n  elif [ \"$1\" = \"canary\" ]; then\n    ssh deploy@canary.example.com \"systemctl restart app\"\n  else\n    curl -fsS -T \"build/app-$RELEASE.tgz\" \"https://prod.example.com/upload\"\n  fi\n}"
      },
      {
        "sym": "function:record_release",
        "kind": "function",
        "name": "record_release",
        "scope": "module",
        "loc": {
          "line": 33,
          "endLine": 35,
          "col": 0,
          "endCol": 1
        },
        "signature": "record_release()",
        "docstring": null,
        "source": "record_release() {\n  psql -h db.internal -c \"insert into releases (tag, stamp) values ('$RELEASE', $BUILD_STAMP)\"\n}"
      },
      {
        "sym": "function:watch_logs",
        "kind": "function",
        "name": "watch_logs",
        "scope": "module",
        "loc": {
          "line": 37,
          "endLine": 41,
          "col": 0,
          "endCol": 1
        },
        "signature": "watch_logs()",
        "docstring": null,
        "source": "watch_logs() {\n  while read -r line; do\n    echo \"$line\"\n  done < /var/log/app.log\n}"
      },
      {
        "sym": "function:main",
        "kind": "function",
        "name": "main",
        "scope": "module",
        "loc": {
          "line": 44,
          "endLine": 60,
          "col": 0,
          "endCol": 1
        },
        "signature": "main($1)",
        "docstring": "Build, upload everywhere, record the release, then run the deploy hook.",
        "source": "main() {\n  log_step \"deploy $RELEASE\"\n  prepare\n  for target in staging prod; do\n    upload \"$target\"\n  done\n  record_release\n  fetch_status | grep -v healthy | tee build/unhealthy.txt\n  case \"$1\" in\n    verbose) watch_logs ;;\n    *) echo \"done\" ;;\n  esac\n  HOOK_CMD=\"${DEPLOY_HOOK:-true}\"\n  \"$HOOK_CMD\" --release \"$RELEASE\"\n  eval \"$POST_DEPLOY\"\n  return 0\n}"
      }
    ],
    "modulePath": "deploy.sh",
    "shebang": "#!/usr/bin/env bash"
  },
