        "docstring": "Simple user model.",
        "source": "class User:\n    \"\"\"Simple user model.\"\"\"\n\n    def __init__(self, name: str) -> None:\n        self.name = name\n        self.active = True\n\n    def deactivate(self) -> None:\n        self.active = False\n\n    def __repr__(self) -> str:\n        status = \"active\" if self.active else \"inactive\"\n        return f\"User({self.name!r}, {status})\"\n"
      },
