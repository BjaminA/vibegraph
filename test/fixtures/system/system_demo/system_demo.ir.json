        },
        "signature": "def get_user(uid)",
        "docstring": null,
        "source": "\n\ndef get_user(uid):\n    cached = cachelib.cache.get(f\"user:{uid}\")\n    if cached:\n        return cached\n    user = store.find_user(uid)\n    cachelib.cache.set(f\"user:{uid}\", user)\n    return user\n"
      },
