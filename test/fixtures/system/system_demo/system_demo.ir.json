        "docstring": "List every user.",
        "source": "\n\n@app.route(\"/api/users\", methods=[\"GET\"])\ndef list_users_route():\n    \"\"\"List every user.\"\"\"\n    users = store.all_users()\n    return jsonify(users)\n"
