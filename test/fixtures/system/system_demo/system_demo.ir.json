        "signature": "def get_user_route(uid)",
        "docstring": "Fetch one user, cache-first.",
        "source": "\n\n@app.route(\"/api/users/<int:uid>\", methods=[\"GET\"])\ndef get_user_route(uid):\n    \"\"\"Fetch one user, cache-first.\"\"\"\n    user = get_user(uid)\n    return jsonify(user)\n"
