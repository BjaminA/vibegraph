        "signature": "def run_job(payload, store)",
        "docstring": null,
        "source": "\n\ndef run_job(payload, store):\n    store.begin()\n    try:\n        record = store.write(payload)\n        return record\n    except ValueError:\n        store.rollback()\n        return None\n    finally:\n        store.close()\n"
      }
