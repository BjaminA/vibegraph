        "signature": "def list_users_route()",
        "docstring": null,
        "source": "\n\n@app.route(\"/users\")\ndef list_users_route():\n    users = list_users()\n    return jsonify([{\"uid\": u.uid, \"name\": u.name, \"email\": u.email} for u in users])\n"
      },
