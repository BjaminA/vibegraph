        "signature": "def create_user_route()",
        "docstring": null,
        "source": "\n\n@app.post(\"/users\")\ndef create_user_route():\n    body = request.get_json()\n    user = create_user(body[\"name\"], body[\"email\"])\n    return jsonify({\"uid\": user.uid}), 201\n"
      }
