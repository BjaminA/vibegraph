        },
        "signature": "def get_user_route(uid)",
        "docstring": null,
        "source": "\n\n@app.route(\"/users/<int:uid>\", methods=[\"GET\"])\ndef get_user_route(uid):\n    user = find_user(uid)\n    if user is None:\n        return jsonify({\"error\": \"not found\"}), 404\n    return jsonify({\"uid\": user.uid, \"name\": user.name, \"email\": user.email})\n"
      },
