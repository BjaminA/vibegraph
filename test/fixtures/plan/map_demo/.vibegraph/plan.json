{
  "version": "1",
  "revision": 4,
  "objective": "Operators see every pump's wear forecast within a minute of a reading",
  "processes": [
    { "id": "api", "kind": "backend", "label": "Ingest API", "serves": "within a minute of a reading", "at": "api/", "status": "agreed" },
    { "id": "forecaster", "kind": "backend", "label": "Forecaster", "serves": "wear forecast", "at": "worker/", "status": "agreed" },
    { "id": "dashboard", "kind": "frontend", "label": "Dashboard", "serves": "operators see", "at": "web/", "status": "proposed" }
  ],
  "stack": [
    { "tool": "sqlite3", "role": "db", "status": "agreed" }
  ],
  "boundaries": [
    { "id": "b1", "from": "api", "to": "sqlite3", "protocol": "SQL", "carries": ["pump_id", "reading", "at"], "status": "agreed" },
    { "id": "b2", "from": "forecaster", "to": "sqlite3", "protocol": "SQL", "status": "agreed" },
    { "id": "b3", "from": "dashboard", "to": "api", "protocol": "HTTP", "carries": ["pump_id"], "status": "proposed" }
  ],
  "threads": [
    { "id": "POST /readings", "entry": "route", "process": "api", "serves": "within a minute of a reading", "primary": ["validate", "b1:insert", "insert_reading"], "status": "agreed" },
    { "id": "forecast_all", "entry": "cli", "process": "forecaster", "serves": "wear forecast", "primary": ["insert_reading", "publish_forecast"], "status": "agreed" },
    { "id": "GET /forecasts", "entry": "route", "process": "api", "serves": "operators see", "primary": ["read_forecasts"], "status": "proposed" },
    { "id": "render_dashboard", "entry": "page", "process": "dashboard", "serves": "operators see", "primary": ["fetch_forecasts", "b3:get"], "status": "proposed" }
  ],
  "policies": [
    { "id": "p1", "text": "Only the API writes readings", "why": "one place validates units", "about": "b1", "status": "agreed" },
    { "id": "p2", "text": "A forecast names the model version that made it", "why": "operators must know which model to distrust", "about": "forecaster", "status": "proposed" }
  ],
  "open": [
    { "id": "q1", "text": "Server-render the dashboard, or a static page polling the API?", "about": "dashboard" }
  ],
  "changelog": []
}
